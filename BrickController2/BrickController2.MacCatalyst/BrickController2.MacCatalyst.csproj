<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-maccatalyst</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers>
    <AssemblyName>BrickController2.MacCatalyst</AssemblyName>
    <ApplicationTitle>BrickController</ApplicationTitle>
    <ApplicationId>de.raphaelvolz.brickcontroller</ApplicationId>
    <RootNamespace>BrickController2.MacCatalyst</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <ValidateXcodeVersion Condition="'$(ValidateXcodeVersion)' == ''">false</ValidateXcodeVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" />
    <PackageReference Include="Microsoft.Maui.Essentials" />
    <!--
      sqlite-net-pcl does not currently ship a Mac Catalyst-specific managed
      asset. Its generic asset selects the bundled e_sqlite3 provider, while
      its iOS asset correctly selects Apple's system sqlite3 library. Use that
      compatible asset for Catalyst and suppress the transitive bundled native
      library so App Store processing cannot remove or invalidate it.
    -->
    <PackageReference Include="sqlite-net-pcl" ExcludeAssets="compile;runtime" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" ExcludeAssets="all" />
    <PackageReference Include="SQLitePCLRaw.provider.sqlite3" />
    <PackageReference Include="SourceGear.sqlite3" ExcludeAssets="all" />
    <ProjectReference Include="..\BrickController2\BrickController2.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SQLite-net">
      <HintPath>$(NuGetPackageRoot)sqlite-net-pcl/$(SQLiteNetPclVersion)/lib/net8.0-ios18.0/SQLite-net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\BrickController2.iOS\PlatformServices\**\*.cs" Link="PlatformServices\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\BrickController2.iOS\UI\**\*.cs" Link="UI\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ImageAsset Include="Assets.xcassets\AppIcon.appiconset\**\*" />
    <MauiSplashScreen Include="..\BrickController2.iOS\Resources\splash.svg" Link="splash.svg" BaseSize="128,128" Color="#990000" />
  </ItemGroup>

  <ItemGroup>
    <MauiAsset Include="..\..\LICENSE.txt" Link="OpenSource\LICENSE.txt" />
    <MauiAsset Include="..\..\THIRD_PARTY_NOTICES.txt" Link="OpenSource\THIRD_PARTY_NOTICES.txt" />
    <MauiAsset Include="..\..\Help\**\*.*" Link="Help\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The .NET Mac Catalyst SDK otherwise re-identifies packaged dylibs as
    @executable_path/../../Contents/MonoBundle/<name>. macOS App Store security
    rejects parent-directory expansion in that load path before the app starts.
    The app already carries @executable_path/../MonoBundle as an LC_RPATH, so
    give every bundled dylib an @rpath identity before the native executable is
    linked and signed.
  -->
  <Target Name="UseSecureMacCatalystDynamicLibraryIds"
          AfterTargets="_ComputeDynamicLibrariesToReidentify"
          BeforeTargets="_InstallNameTool">
    <ItemGroup>
      <_DynamicLibraryToReidentify Update="@(_DynamicLibraryToReidentify)">
        <DynamicLibraryId>@rpath/%(Filename)%(Extension)</DynamicLibraryId>
      </_DynamicLibraryToReidentify>
    </ItemGroup>
  </Target>

</Project>
